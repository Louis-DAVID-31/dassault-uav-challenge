{
    "mission_control": {
        "run_mode": "dev",
        "show_real_live_video": true,
        "show_processed_live_video" : true,
        "print_terminal_debug": true
    },

    "camera_hardware":{
        "capture_source": 0,
        "resolution_width": 640,
        "resolution_height": 480,
        "camera_matrix": [
            [1.28720518e+03, 0.0, 2.89847984e+02],
            [0.0, 1.29164843e+03, 3.34968971e+02],
            [0.0, 0.0, 1.0]
        ],
        "distortion_coeffs": [-2.10580199e-01, 6.21571346e+00, 1.53852419e-02, -9.00164461e-03, -4.78383013e+01],
        "offset_forward_m": 0,
        "offset_right_m": 0,
        "offset_down_m": 0
    },

    "detection_algorithm": {
        "target_whitelist": [0,1,2,3,4],
        "aruco_dictionary": "DICT_4X4_50",
        "verification_sliding_window_frames": 15,
        "verification_min_detections_required": 4,
        "tracking_max_distance_pixel": 30,
        "tracking_max_distance_m": 15,
        "stopping_window_frames": 10,
        "aruco_parameters": {
            "min_marker_perimeter_rate": 0.005,
            "max_marker_perimeter_rate": 4.0,
            "polygonal_approx_accuracy_rate": 0.05
        },
        "image_enhancement": {
            "use_clahe": true,
            "clahe_clip_limit": 2.0
        }
    },

    "logging_and_output":{
        "outputs_directory": "outputs/",
        "log_directory": "logs/",
        "image_save_directory": "verified_markers/",
        "save_images_enabled": true,
        "log_mistakes": true
    }
}